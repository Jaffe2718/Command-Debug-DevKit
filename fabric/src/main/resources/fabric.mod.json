{
    "schemaVersion": 1,
    "id": "cmdkit",
    "version": "${version}",
    "name": "Command Debug Service",
    "description": "This is a mod that provides a method to execute and debug Minecraft commands by creating socket connections between Minecraft and external programs. It is used to be a command debug connect kit between Minecraft and external programs.",
    "authors": [
        "Jaffe2718"
    ],
    "contact": {
        "homepage": "https://modrinth.com/mod/command-debug-service",
        "issues": "https://github.com/Jaffe2718/Command-Debug-DevKit/issues",
        "sources": "https://github.com/Jaffe2718/Command-Debug-DevKit",
        "email": "qqyttwqeei@163.com"
    },
    "license": "MIT",
    "icon": "assets/cmdkit/icon.png",
    "environment": "*",
    "entrypoints": {
        "main": ["me.jaffe2718.cmdkit.CommandDebugDevKit"]
    },
    "mixins": [
        "cmdkit.mixins.json"
    ],
    "depends": {
        "fabricloader": ">=0.15.0",
        "fabric-lifecycle-events-v1": "*",
        "fabric-message-api-v1": "*",
        "minecraft": "${compatible_minecraft_versions}"
    },
    "recommends": {
        "midnightlib": ">=${midnightlib_version}"
    },
    "custom": {
        "modmenu": {
            "links": {
                "cmdkit.modrinth": "https://modrinth.com/mod/command-debug-service"
            },
            "update_checker": true
        }
    }
}
